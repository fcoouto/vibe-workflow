{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code SessionStart",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code PreToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code PostToolUse",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code PostToolUseFailure",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code Stop",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code UserPromptSubmit",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code SubagentStart",
            "timeout": 5
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/workflow.py\" claude-code SubagentStop",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
