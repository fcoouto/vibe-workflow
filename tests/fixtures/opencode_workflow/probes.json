  "requests": 20,
  "attempts": 2,
  "minutes": 15,
  "approved_by": "user, 12 November 2026"
 },
 "recorded": "key sets and fixed facts only; no prompts, file contents, commands, tool output or messages. Session roles are root, child or unknown as the probe plugin saw them; 'grandchild' means a child of a session the probe had not seen created.",
 "observations": {
  "shell_exit_status": "tool.execute.after result.metadata.exit (number); metadata also has status (string) and truncated",
  "call_correlation": "permission.evaluate source.id equals tool.execute.after id for shell, write, the refused write and subagent",
  "edit_resources": "relative paths for the write tool (action edit)",
  "denial": "a permission.evaluate deny message reached the model verbatim; the refused file was not created; tool.execute.after status error",
  "routes": "model.request kind primary with variant low for root and child",
  "prompt_hook": "fires for root prompts and for subagent prompts; the subagent prompt arrives before the child's session.created",
  "root_creation_event": "not observed in either run; the root became known only through session.get",
  "finished_runs": "session.execution.succeeded carries the child sessionID",
  "resumed_session": "a fresh server resuming the session: hooks name it with no creation event; session.get returns a flat record without parentID",
  "subagent_input": "subagent tool input keys agent, description, prompt (no follow-up sessionID in a new spawn)"
 },
 "unobserved": [
  "permission.evaluate from a child session (the child made no tool calls)",
  "session.get for a child record (repo evidence: clients/opencode.md, parentID from session.get, live 9 November 2026)",
  "the interactive TUI: whether it delivers the root's session.created"
